    "type": "git",
    "url": "https://github.com/raman1112240132-alt/ATS-RESUME-BUILDER.git",
    "directory": "."
  },
  "bugs": {
    "url": "https://github.com/raman1112240132-alt/ATS-RESUME-BUILDER/issues"
  },
  "homepage": "https://vishishtresume.vercel.app",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "os": ["darwin", "linux", "win32"],
  "cpu": ["x64", "arm64"],
  "private": false,
